generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Demande {
  id                   Int       @id @default(autoincrement())
  prenom_nom           String
  filiere              String
  annee                String
  sujet                String
  description          String
  duree                Int
  date_heure           DateTime
  lieu                 String
  nb_souhaites         Int
  nb_inscrits          Int       @default(0)
  types_retour         String    @default("[]")
  created_at           DateTime  @default(now())

  messages             Message[]
  inscriptions         Inscription[]
}

model Message {
  id           Int      @id @default(autoincrement())
  demande_id   Int
  demande      Demande  @relation(fields: [demande_id], references: [id], onDelete: Cascade)
  prenom_nom   String
  contenu      String
  created_at   DateTime @default(now())
}

model Inscription {
  id         Int      @id @default(autoincrement())
  demande_id Int
  demande    Demande  @relation(fields: [demande_id], references: [id], onDelete: Cascade)
  prenom_nom String
  created_at DateTime @default(now())
}